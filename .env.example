# Salin file ini menjadi .env.local lalu isi dari Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kunci rahasia untuk tanda tangan SHA-512 (minimal 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JANGAN pernah diganti setelah ada transaksi — semua kuitansi lama akan menjadi TIDAK VALID.
KUNCI_SHA512=

# Alamat aplikasi setelah di-deploy (dipakai di QR kuitansi)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Midtrans Sandbox
# Server Key (Settings → Access Keys): dipakai Midtrans menandatangani notifikasi → verifikasi SHA-512
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxx
# API Key (Settings → API Keys): untuk memanggil Snap/Status API. Kosongkan bila sama dengan Server Key.
MIDTRANS_API_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
